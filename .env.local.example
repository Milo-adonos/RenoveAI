# Kie.ai
KIE_API_KEY=your_kie_api_key

# fal.ai (recommandé — génération < 25 s)
FAL_KEY=your_fal_api_key

# Stripe
STRIPE_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXX

# Stripe Price IDs
STRIPE_PRICE_WEEKLY=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_MONTHLY=price_XXXXXXXXXXXXXXXX
STRIPE_PRICE_ANNUAL=price_XXXXXXXXXXXXXXXX

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=XXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=XXXXXXXXXXXXXXXX

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
